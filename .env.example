# ==============================================================================
# BITMILL APPLICATION ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=8080
RTMP_PORT=1935
BASE_URL=http://localhost:8080
ENV=development

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 Storage (Direct S3-Compatible Ingestion)
# ------------------------------------------------------------------------------
# Storage Provider Selection: "gcs" (Google Cloud Storage) or "r2" (Cloudflare R2)
STORAGE_PROVIDER=gcs

# Transcoder Engine: "gcp" (Serverless Google Cloud Transcoder), "docker", or "native"
TRANSCODER_TYPE=gcp

# ------------------------------------------------------------------------------
# 2.1 Google Cloud Platform (GCS & Serverless Transcoder API)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=bitmill-project
GCP_REGION=asia-southeast1
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GCS_RAW_BUCKET=bitmill-raw-videos
GCS_PROCESSED_BUCKET=bitmill-processed-videos
GCS_PUBLIC_DOMAIN=https://storage.googleapis.com/bitmill-processed-videos
GCP_PUBSUB_TOPIC=bitmill-transcoder-events
GCP_PUBSUB_SUBSCRIPTION=bitmill-transcoder-events-sub

# ------------------------------------------------------------------------------
# 2.2 Cloudflare R2 Storage (Fallback Multi-Provider)
# ------------------------------------------------------------------------------
# Cloudflare Account ID: Found on Cloudflare Dashboard -> R2 Overview (Right sidebar)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# R2 API Tokens: Generated under 'Manage R2 API Tokens' with 'Object Read & Write' permission
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# S3-Compatible Endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your_cloudflare_account_id_here.r2.cloudflarestorage.com

# Target Bucket Names on Cloudflare R2
R2_RAW_BUCKET=bitmill-raw-videos
R2_PROCESSED_BUCKET=bitmill-processed-videos

# Public R2 Domain for HLS Video Playback (Custom Domain or pub-xxxx.r2.dev)
R2_PUBLIC_DOMAIN=https://pub-your_bucket_hash.r2.dev

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (RMDS)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bitmill_user
POSTGRES_PASSWORD=bitmill_password
POSTGRES_DB=bitmill_media
POSTGRES_SSLMODE=disable

# Connection Pool Settings
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME=300s

# ------------------------------------------------------------------------------
# 4. RabbitMQ Message Broker (AMQP 0-9-1)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=bitmill_mq
RABBITMQ_PASSWORD=bitmill_mq_password
RABBITMQ_VHOST=/
RABBITMQ_URI=amqp://bitmill_mq:bitmill_mq_password@localhost:5672/

# Queue Topology
RABBITMQ_EXCHANGE=bitmill.video.events
RABBITMQ_QUEUE=video.transcoding.jobs
RABBITMQ_ROUTING_KEY=video.transcode.job
RABBITMQ_DLX=bitmill.video.dlx
RABBITMQ_DLQ=video.transcoding.dlq

# ------------------------------------------------------------------------------
# 5. Media Transcoder (Docker FFmpeg)
# ------------------------------------------------------------------------------
FFMPEG_DOCKER_IMAGE=mwader/static-ffmpeg:latest
HLS_SEGMENT_DURATION=4
GOP_SIZE=60

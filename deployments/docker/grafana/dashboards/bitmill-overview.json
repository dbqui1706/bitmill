        },
        {
          "expr": "rate(rabbitmq_queue_messages_delivered_total{queue=\"video.transcoding.jobs\"}[1m])",
          "legendFormat": "Delivery Rate (Worker Consumption)",
          "refId": "B"
        }
      ],
      "title": "📬 RabbitMQ Ingestion vs Consumption Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
